{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm seed)",
      "Bash(pnpm prisma generate)",
      "Bash(pnpm prisma migrate dev:*)",
      "Bash(pnpm -C mcp-server build)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(*/git push *)",
      "Bash(*/git * push)",
      "Bash(*/git * push *)",
      "Bash(git send-pack *)",
      "Bash(git * send-pack)",
      "Bash(git * send-pack *)",
      "Bash(*/git send-pack *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
